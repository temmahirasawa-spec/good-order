# ──────────────────────────────────────────────────────────────
# 公開URL（SEO / OGP / sitemap の絶対URLに使う）
# ──────────────────────────────────────────────────────────────

# 独自ドメインを当てたら「ドメインだけ」を入れる（末尾スラッシュ不要）。
#   正: https://app.good-order.jp
#   誤: https://app.good-order.jp/yorkys-shukugawa  ← 店舗の接頭辞は付けない
# 接頭辞は下の NEXT_PUBLIC_BASE_PATH からコードが自動で足す。ここに書くと二重になる。
# 未設定なら Vercel の本番URL → それも無ければ既定値、の順に自動で決まるので
# ローカル開発では空のままでよい。
NEXT_PUBLIC_SITE_URL=

# 店舗ごとのURL接頭辞。app.good-order.jp の下に店舗をパスで並べるための設定。
#   YORKYS本番     /yorkys-shukugawa
#   デモ・ローカル   空のまま（＝ルート直下で動く）
# 先頭は必ず「/」、末尾に「/」は付けない。
# これを変えると二次元コードが指すURLも変わるので、変更したら卓の紙を刷り直すこと。
NEXT_PUBLIC_BASE_PATH=

# Google Search Console を「HTMLタグ」方式で確認するときの content 値だけを入れる。
# 例: <meta name="google-site-verification" content="abc123..."> の abc123... の部分。
# DNS / HTMLファイル方式で確認済みなら不要。
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ──────────────────────────────────────────────────────────────
# Supabase 接続設定
# Supabase Dashboard > Settings > API からコピー
# ──────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ──────────────────────────────────────────────────────────────
# サーバーサイド専用（API Routes / Cron）
# Supabase Dashboard > Settings > API の「service_role」キー
# ──────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ──────────────────────────────────────────────────────────────
# AI 日報（/api/daily-report）
# ──────────────────────────────────────────────────────────────

# Slack Incoming Webhook URL（省略すると Slack に送らない）
SLACK_WEBHOOK_URL=

# LINE Notify トークン（省略すると LINE に送らない）
# ※ LINE Notify は 2025/3 末で提供終了。互換用に残しています
LINE_NOTIFY_TOKEN=

# Cron からの呼び出し認証用。`openssl rand -hex 32` で生成推奨
# Vercel Cron は Authorization: Bearer ${CRON_SECRET} を自動付与する
CRON_SECRET=

# ──────────────────────────────────────────────────────────────
# 厨房プリンタ（/api/print）
# ──────────────────────────────────────────────────────────────

# プリンタが叩くURLに埋め込む秘密のトークン。`openssl rand -hex 24` で生成する。
# プリンタの設定画面（Web Config）に入れるURLは
#   https://<本番ドメイン>/api/print/<この値>
# 未設定のあいだ /api/print は 503 を返し、印刷は行われない（注文には影響しない）。
PRINT_ENDPOINT_TOKEN=
